# Copy to .env and fill in. All vars are prefixed COMPACTION_ per
# EngineSettings(SettingsConfigDict(env_prefix="COMPACTION_")).

# --- Provider selection ---
COMPACTION_LLM_PROVIDER=anthropic          # anthropic | openai | local_ollama | fake
COMPACTION_LLM_MODEL_NAME=claude-haiku-4-5-20251001
COMPACTION_LLM_TEMPERATURE=0.0
COMPACTION_LLM_MAX_RETRIES=3
COMPACTION_LLM_REQUEST_TIMEOUT_S=30.0

# --- Provider credentials (read directly by the underlying SDK, not by this app) ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Chunking / extraction ---
COMPACTION_MAX_TURNS_PER_CHUNK=8
COMPACTION_MAX_FACTS_PER_CHUNK=20

# --- Dedup / reranker ---
COMPACTION_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
COMPACTION_DEDUP_COSINE_THRESHOLD=0.92

# --- Integrity validator hard gates ---
COMPACTION_MIN_ACCEPTABLE_FACT_RECALL=0.90
COMPACTION_MAX_ACCEPTABLE_HALLUCINATION_RATE=0.02
COMPACTION_MIN_ACCEPTABLE_CONSTRAINT_RECALL=0.99

# --- Phase 3: Cost prediction & arbitration ---
COMPACTION_COST_SAVING_THRESHOLD_TOKENS=50
COMPACTION_COST_MIN_TURNS_TO_COMPRESS=3
COMPACTION_COST_PREDICTOR_MIN_SAMPLES=10
COMPACTION_COST_TOKEN_PRICE_PER_MILLION_USD=0.80
COMPACTION_COST_MAX_BACKOFF_TO_COMPRESS=3.0

# --- Observability ---
COMPACTION_LOG_LEVEL=INFO
COMPACTION_ENABLE_JSON_LOGGING=true
